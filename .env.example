# Copie este arquivo para .env.local e preencha com os valores reais.
# Nunca commite .env.local — ele está no .gitignore.

# ---------------------------------------------------------------------------
# Neon (Postgres)
# Painel do Neon > seu projeto > Connection string
# ---------------------------------------------------------------------------
# Conexão POOLED (tem "-pooler" no host). Usada pela app em runtime e no build.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Conexão DIRETA (sem "-pooler"). Usada por `prisma db push` / migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Clerk (autenticação)
# Painel do Clerk > sua aplicação > API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"
CLERK_SECRET_KEY="sk_test_xxxxx"

# Signing secret do webhook de sync de User.
# Clerk > Webhooks > Add Endpoint > https://SEU-DOMINIO/api/webhooks/clerk
# Eventos: user.created, user.updated, user.deleted
# Opcional em dev: sem webhook, o usuário é criado no primeiro acesso
# (ensureUser() em src/lib/session.ts).
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxxxx"

# ---------------------------------------------------------------------------
# Anthropic (camada de IA — assistente de conteúdo do creator)
# console.anthropic.com > API Keys > Create Key
#
# ATENÇÃO: assinatura do Claude.ai ou do Claude Code NÃO dá acesso à API.
# São faturamentos separados; o consumo aqui é cobrado por token.
#
# Sem esta variável a tela de IA mostra "não configurado" e nada é gerado —
# nenhum texto de exemplo é exibido como se fosse da IA.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."

# Rotas de auth deste projeto (as páginas ficam em /login e /signup).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
