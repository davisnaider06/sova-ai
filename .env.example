# Copie este arquivo para .env.local e preencha com os valores reais.
# Nunca commite .env.local — ele está no .gitignore.

# ---------------------------------------------------------------------------
# Neon (Postgres)
# Painel do Neon > seu projeto > Connection string
# ---------------------------------------------------------------------------
# Conexão POOLED (tem "-pooler" no host). Usada pela app em runtime e no build.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Conexão DIRETA (sem "-pooler"). Usada por `prisma db push` / migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Clerk (autenticação)
# Painel do Clerk > sua aplicação > API Keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"
CLERK_SECRET_KEY="sk_test_xxxxx"

# Signing secret do webhook de sync de User.
# Clerk > Webhooks > Add Endpoint > https://SEU-DOMINIO/api/webhooks/clerk
# Eventos: user.created, user.updated, user.deleted
# Opcional em dev: sem webhook, o usuário é criado no primeiro acesso
# (ensureUser() em src/lib/session.ts).
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxxxx"

# ---------------------------------------------------------------------------
# Anthropic (camada de IA — assistente de conteúdo do creator)
# console.anthropic.com > API Keys > Create Key
#
# ATENÇÃO: assinatura do Claude.ai ou do Claude Code NÃO dá acesso à API.
# São faturamentos separados; o consumo aqui é cobrado por token.
#
# Sem esta variável a tela de IA mostra "não configurado" e nada é gerado —
# nenhum texto de exemplo é exibido como se fosse da IA.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."

# ---------------------------------------------------------------------------
# TikTok — Login Kit / Display API (conta do creator)
# developers.tiktok.com > sua app > Login Kit
#
# Esta é a conexão da CONTA do creator (perfil e vídeos próprios). Não é a API
# do TikTok Shop, que é outra autorização, outro portal e outros dados
# (produtos, pedidos, GMV) — ver TIKTOK-INTEGRACAO.md.
#
# O redirect precisa bater EXATAMENTE com o cadastrado no painel do TikTok,
# incluindo esquema e barra final.
#
# ATENÇÃO: para plataforma Web o TikTok exige https e RECUSA localhost — a
# permissão de localhost/http vale só para apps Desktop. Em desenvolvimento,
# use um túnel HTTPS (ngrok, Cloudflare Tunnel) e cadastre a URL do túnel como
# redirect URI adicional no painel. Ver TIKTOK-INTEGRACAO.md §3.
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY="aw..."
TIKTOK_CLIENT_SECRET="..."
TIKTOK_REDIRECT_URI="https://SEU-DOMINIO/api/tiktok/callback"

# Chave de criptografia dos tokens de conta externa (AES-256-GCM).
# Gere com:  openssl rand -base64 32
#
# Sem ela a conexão com o TikTok é bloqueada antes de começar — gravar token de
# terceiro em texto puro não é opção. Trocar a chave depois invalida os tokens
# já guardados e força reconexão dos usuários.
TOKEN_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Worker da fila (/api/cron/jobs), disparado pelo cron da Vercel.
# Gere com:  openssl rand -base64 32
#
# A Vercel envia este valor como `Authorization: Bearer ...` nas invocações
# agendadas. Sem a variável a rota responde 503 e o worker fica desligado — de
# propósito: um endpoint que dispara trabalho em nome de qualquer perfil não
# pode ficar aberto na internet.
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Assinatura (Hubla) e administração
# ---------------------------------------------------------------------------
# Token do webhook: Hubla > Integrações > Webhooks > Ativar integração, e
# depois o botão "Autenticação". Sem ele a rota /api/webhooks/hubla responde
# 503 e nenhuma assinatura é liberada automaticamente.
HUBLA_WEBHOOK_TOKEN=""

# E-mails que entram como administradores, separados por vírgula.
# É só o bootstrap do primeiro admin — depois ele promove os outros pela tela
# de Administração, e o papel real passa a viver em User.role.
# Admin entra sem assinatura, de propósito: o dono não pode ficar trancado
# fora do próprio produto se o gateway oscilar.
ADMIN_EMAILS="voce@exemplo.com"

# Rotas de auth deste projeto (as páginas ficam em /login e /signup).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
